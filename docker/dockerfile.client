FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY angular.json tsconfig*.json ngsw-config.json ./
COPY public ./public
COPY src ./src
RUN npm run build-hosted

FROM nginx:alpine
COPY --from=build /app/dist/toodoom/browser /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
